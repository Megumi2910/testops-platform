# Environment and secrets
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
backend/.secrets/*
!backend/.secrets/
!backend/.secrets/.gitkeep

# Java / Maven
backend/target/
**/target/
*.class

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/pnpm-lock.yaml
.pnpm-store/
.agent/
.playwright-mcp/
qa-artifacts/
*.tsbuildinfo

# Runtime artifacts (keep the directory marker)
artifacts/*
!artifacts/.gitkeep

# IDE and OS files
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Logs and local caches
*.log
.cache/
