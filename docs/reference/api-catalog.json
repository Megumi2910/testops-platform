    {"id":"admin","label":"Platform administration","source":["backend/src/main/java/com/megumi/testops/auth/api/AdminUserController.java","backend/src/main/java/com/megumi/testops/project/api/AdminTargetOriginController.java"],"endpoints":[
      {"method":"GET","path":"/admin/users","summary":"List platform users with bounded pagination and optional search.","auth":"bearer","permission":"USER_ADMINISTER","query":{"query":"optional search text","page":"zero-based page; default 0","size":"page size; default 25"},"headers":[],"body":null,"success":{"status":200,"shape":"PageResponse<UserResponse>"},"errors":[401,403,400,500],"example":"GET /api/v1/admin/users?page=0&size=25&query=qa"},
      {"method":"PATCH","path":"/admin/users/{id}/platform-role","summary":"Replace a user’s platform role.","auth":"bearer","permission":"USER_ADMINISTER","pathParams":{"id":"UUID"},"query":[],"headers":[],"body":{"platformRole":"MEMBER | ADMIN"},"success":{"status":200,"shape":"UserResponse"},"errors":[400,401,403,404,409,500],"example":"PATCH /api/v1/admin/users/<id>/platform-role"},
      {"method":"PATCH","path":"/admin/users/{id}/status","summary":"Activate, lock, or disable a user while preserving the active-admin invariant.","auth":"bearer","permission":"USER_ADMINISTER","pathParams":{"id":"UUID"},"query":[],"headers":[],"body":{"status":"ACTIVE | LOCKED | DISABLED"},"success":{"status":200,"shape":"UserResponse"},"errors":[400,401,403,404,409,500],"example":"PATCH /api/v1/admin/users/<id>/status"},
      {"method":"POST","path":"/admin/users/{id}/sessions/revoke-all","summary":"Revoke all sessions for a selected user.","auth":"bearer","permission":"USER_ADMINISTER","pathParams":{"id":"UUID"},"query":[],"headers":[],"body":null,"success":{"status":204,"shape":"empty"},"errors":[401,403,404,409,500],"example":"POST /api/v1/admin/users/<id>/sessions/revoke-all"},
      {"method":"GET","path":"/admin/target-origins","summary":"List environment and administrator-managed target origins with usability and project usage.","auth":"bearer","permission":"USER_ADMINISTER","query":[],"headers":[],"body":null,"success":{"status":200,"shape":"TargetOriginResponse[]"},"errors":[401,403,500],"example":"GET /api/v1/admin/target-origins"},
      {"method":"POST","path":"/admin/target-origins","summary":"Register a canonical safe HTTP(S) target origin for the platform.","auth":"bearer","permission":"USER_ADMINISTER","query":[],"headers":[],"body":{"origin":"https://staging.example.com"},"validation":["origin is HTTP(S) only with no credentials, path, query, or fragment","unsafe literal/private addresses are rejected","canonical duplicate origins are rejected"],"success":{"status":200,"shape":"TargetOriginResponse"},"errors":[400,401,403,409,500],"example":"POST /api/v1/admin/target-origins"},
      {"method":"PATCH","path":"/admin/target-origins/{id}","summary":"Enable or disable an administrator-managed origin using optimistic version protection. Environment entries are immutable.","auth":"bearer","permission":"USER_ADMINISTER","pathParams":{"id":"UUID"},"query":[],"headers":[],"body":{"enabled":false,"version":2},"success":{"status":200,"shape":"TargetOriginResponse"},"errors":[400,401,403,404,409,500],"example":"PATCH /api/v1/admin/target-origins/<id>"}
    ]},
    {"id":"projects","label":"Projects, target checks, and members","source":["backend/src/main/java/com/megumi/testops/project/api/ProjectController.java"],"endpoints":[
      {"method":"GET","path":"/projects","summary":"List projects visible to the current user.","auth":"bearer","permission":"email verified","query":{"page":"zero-based; default 0","size":"default 25","q":"optional name search"},"headers":[],"body":null,"success":{"status":200,"shape":"PageResponse<ProjectResponse>"},"errors":[401,403,400,500],"example":"GET /api/v1/projects?page=0&size=25&q=store"},
      {"method":"POST","path":"/projects","summary":"Create a project and assign the creator as project manager.","auth":"bearer","permission":"PROJECT_CREATE","query":[],"headers":[],"body":{"name":"Local Storefront","description":"QA target","targetOrigin":"http://localhost:3001"},"validation":["name is required and at most 120 characters","description is at most 2000 characters","targetOrigin is required and at most 2048 characters"],"success":{"status":201,"shape":"ProjectResponse"},"errors":[400,401,403,409,500],"example":"POST /api/v1/projects"},
      {"method":"GET","path":"/projects/{id}","summary":"Read one project and its onboarding/target-health summary.","auth":"bearer","permission":"project member","pathParams":{"id":"UUID"},"query":[],"headers":[],"body":null,"success":{"status":200,"shape":"ProjectResponse"},"errors":[401,403,404,500],"example":"GET /api/v1/projects/<project-id>"},
      {"method":"PUT","path":"/projects/{id}","summary":"Update project metadata with optimistic version protection.","auth":"bearer","permission":"PROJECT_EDIT","pathParams":{"id":"UUID"},"query":[],"headers":[],"body":{"name":"Local Storefront","description":"Updated QA target","targetOrigin":"http://localhost:3001","projectVersion":"current numeric version"},"headersRequired":["If-Match is used by archive/restore; projectVersion is required for updates"],"success":{"status":200,"shape":"ProjectResponse"},"errors":[400,401,403,404,409,500],"example":"PUT /api/v1/projects/<project-id>"},
      {"method":"POST","path":"/projects/{id}/target-check","summary":"Check the approved target and persist sanitized target health.","auth":"bearer","permission":"EXECUTION_START","pathParams":{"id":"UUID"},"query":[],"headers":[],"body":null,"success":{"status":200,"shape":"TargetCheckResponse with status/httpStatus/checkedAt/reason"},"errors":[401,403,404,409,500],"example":"POST /api/v1/projects/<project-id>/target-check"},
      {"method":"POST","path":"/projects/{id}/archive","summary":"Archive a project without deleting execution history.","auth":"bearer","permission":"PROJECT_EDIT","pathParams":{"id":"UUID"},"query":[],"headers":{"If-Match":"current numeric version"},"body":null,"success":{"status":200,"shape":"ProjectResponse"},"errors":[401,403,404,409,500],"example":"POST /api/v1/projects/<project-id>/archive"},
      {"method":"POST","path":"/projects/{id}/restore","summary":"Restore an archived project.","auth":"bearer","permission":"PROJECT_EDIT","pathParams":{"id":"UUID"},"query":[],"headers":{"If-Match":"current numeric version"},"body":null,"success":{"status":200,"shape":"ProjectResponse"},"errors":[401,403,404,409,500],"example":"POST /api/v1/projects/<project-id>/restore"},
      {"method":"GET","path":"/projects/{id}/members","summary":"List project members and their roles.","auth":"bearer","permission":"project member","pathParams":{"id":"UUID"},"query":[],"headers":[],"body":null,"success":{"status":200,"shape":"MemberResponse[]"},"errors":[401,403,404,500],"example":"GET /api/v1/projects/<project-id>/members"},
      {"method":"POST","path":"/projects/{id}/members","summary":"Add an existing user to a project by normalized email.","auth":"bearer","permission":"MEMBERS_MANAGE","pathParams":{"id":"UUID"},"query":[],"headers":[],"body":{"email":"qa.viewer@example.test","role":"VIEWER","projectVersion":"current numeric version"},"success":{"status":201,"shape":"MemberResponse"},"errors":[400,401,403,404,409,500],"example":"POST /api/v1/projects/<project-id>/members"},
      {"method":"PUT","path":"/projects/{id}/members/{userId}","summary":"Change one project member’s role.","auth":"bearer","permission":"MEMBERS_MANAGE","pathParams":{"id":"UUID","userId":"UUID"},"query":[],"headers":[],"body":{"role":"PROJECT_MANAGER | TEST_MANAGER | TESTER | VIEWER","projectVersion":"current numeric version"},"success":{"status":200,"shape":"MemberResponse"},"errors":[400,401,403,404,409,500],"example":"PUT /api/v1/projects/<project-id>/members/<user-id>"},
      {"method":"DELETE","path":"/projects/{id}/members/{userId}","summary":"Remove a project membership; users themselves are not deleted.","auth":"bearer","permission":"MEMBERS_MANAGE","pathParams":{"id":"UUID","userId":"UUID"},"query":{"projectVersion":"optional numeric version"},"headers":[],"body":null,"success":{"status":204,"shape":"empty"},"errors":[401,403,404,409,500],"example":"DELETE /api/v1/projects/<project-id>/members/<user-id>?projectVersion=4"}
    ]},
    {"id":"variables","label":"Project variables","source":["backend/src/main/java/com/megumi/testops/project/api/ProjectVariableController.java"],"endpoints":[
      {"method":"GET","path":"/projects/{projectId}/variables","summary":"List variable names and metadata; secret values remain masked.","auth":"bearer","permission":"VARIABLE_VIEW","pathParams":{"projectId":"UUID"},"query":[],"headers":[],"body":null,"success":{"status":200,"shape":"VariableResponse[]"},"errors":[401,403,404,500],"example":"GET /api/v1/projects/<project-id>/variables"},
      {"method":"POST","path":"/projects/{projectId}/variables","summary":"Create a plain or secret variable.","auth":"bearer","permission":"VARIABLE_MANAGE","pathParams":{"projectId":"UUID"},"query":[],"headers":[],"body":{"key":"SHOP_TEST_EMAIL","secret":false,"value":"qa.user@example.test","projectVersion":"current numeric version"},"validation":["key matches [A-Za-z][A-Za-z0-9_]{1,63}","value is at most 10000 characters"],"success":{"status":201,"shape":"VariableResponse"},"errors":[400,401,403,404,409,500],"example":"POST /api/v1/projects/<project-id>/variables"},
      {"method":"PUT","path":"/projects/{projectId}/variables/{key}","summary":"Rotate or update a project variable.","auth":"bearer","permission":"VARIABLE_MANAGE","pathParams":{"projectId":"UUID","key":"variable key"},"query":[],"headers":[],"body":{"key":"SHOP_TEST_EMAIL","secret":false,"value":"qa.user@example.test","projectVersion":"current numeric version"},"success":{"status":200,"shape":"VariableResponse"},"errors":[400,401,403,404,409,500],"example":"PUT /api/v1/projects/<project-id>/variables/SHOP_TEST_EMAIL"},
      {"method":"DELETE","path":"/projects/{projectId}/variables/{key}","summary":"Delete a variable after reference checks.","auth":"bearer","permission":"VARIABLE_MANAGE","pathParams":{"projectId":"UUID","key":"variable key"},"query":{"projectVersion":"optional numeric version"},"headers":[],"body":null,"success":{"status":204,"shape":"empty"},"errors":[401,403,404,409,500],"example":"DELETE /api/v1/projects/<project-id>/variables/SHOP_TEST_EMAIL"}
    ]},
    {"id":"definitions","label":"Suites, cases, steps, Trash, and restore","source":["backend/src/main/java/com/megumi/testops/project/api/DefinitionController.java"],"endpoints":[
      {"method":"GET","path":"/projects/{projectId}/suites","summary":"List suites by lifecycle.","auth":"bearer","permission":"project member","pathParams":{"projectId":"UUID"},"query":{"lifecycle":"ACTIVE | ARCHIVED | ALL; default ACTIVE"},"headers":[],"body":null,"success":{"status":200,"shape":"SuiteResponse[]"},"errors":[401,403,404,500],"example":"GET /api/v1/projects/<project-id>/suites?lifecycle=ALL"},
      {"method":"GET","path":"/projects/{projectId}/suites/{suiteId}","summary":"Read one suite with project ancestry checks.","auth":"bearer","permission":"project member","pathParams":{"projectId":"UUID","suiteId":"UUID"},"query":[],"headers":[],"body":null,"success":{"status":200,"shape":"SuiteResponse"},"errors":[401,403,404,500],"example":"GET /api/v1/projects/<project-id>/suites/<suite-id>"},
      {"method":"POST","path":"/projects/{projectId}/suites","summary":"Create a suite in an active project.","auth":"bearer","permission":"DEFINITION_MANAGE","pathParams":{"projectId":"UUID"},"query":[],"headers":[],"body":{"name":"Platform smoke","description":"Critical health checks","projectVersion":"current numeric version"},"validation":["name is required and at most 160 characters","description is at most 2000 characters"],"success":{"status":201,"shape":"SuiteResponse"},"errors":[400,401,403,404,409,500],"example":"POST /api/v1/projects/<project-id>/suites"},
      {"method":"PUT","path":"/projects/{projectId}/suites/{suiteId}","summary":"Edit an active suite.","auth":"bearer","permission":"DEFINITION_MANAGE","pathParams":{"projectId":"UUID","suiteId":"UUID"},"query":[],"headers":[],"body":{"name":"Platform smoke","description":"Updated description","projectVersion":"current numeric version"},"success":{"status":200,"shape":"SuiteResponse"},"errors":[400,401,403,404,409,500],"example":"PUT /api/v1/projects/<project-id>/suites/<suite-id>"},
      {"method":"POST","path":"/projects/{projectId}/suites/{suiteId}/archive","summary":"Compatibility archive route for a suite.","auth":"bearer","permission":"DEFINITION_MANAGE","pathParams":{"projectId":"UUID","suiteId":"UUID"},"query":[],"headers":[],"body":null,"success":{"status":204,"shape":"empty"},"errors":[401,403,404,409,500],"example":"POST /api/v1/projects/<project-id>/suites/<suite-id>/archive"},
      {"method":"DELETE","path":"/projects/{projectId}/suites/{suiteId}","summary":"Move a suite to history-preserving Trash.","auth":"bearer","permission":"DEFINITION_MANAGE","pathParams":{"projectId":"UUID","suiteId":"UUID"},"query":[],"headers":{"If-Match":"current numeric version"},"body":null,"success":{"status":200,"shape":"SuiteResponse with archived metadata"},"errors":[401,403,404,409,500],"example":"DELETE /api/v1/projects/<project-id>/suites/<suite-id>"},
      {"method":"POST","path":"/projects/{projectId}/suites/{suiteId}/restore","summary":"Restore a suite, optionally renaming on conflict.","auth":"bearer","permission":"DEFINITION_MANAGE","pathParams":{"projectId":"UUID","suiteId":"UUID"},"query":[],"headers":[],"body":{"version":"current numeric version","name":"optional replacement name"},"success":{"status":200,"shape":"SuiteResponse"},"errors":[400,401,403,404,409,500],"example":"POST /api/v1/projects/<project-id>/suites/<suite-id>/restore"},
      {"method":"GET","path":"/projects/{projectId}/suites/{suiteId}/cases","summary":"List cases by lifecycle.","auth":"bearer","permission":"project member","pathParams":{"projectId":"UUID","suiteId":"UUID"},"query":{"lifecycle":"ACTIVE | ARCHIVED | ALL; default ACTIVE"},"headers":[],"body":null,"success":{"status":200,"shape":"CaseResponse[]"},"errors":[401,403,404,500],"example":"GET /api/v1/projects/<project-id>/suites/<suite-id>/cases?lifecycle=ALL"},
      {"method":"POST","path":"/projects/{projectId}/suites/{suiteId}/cases","summary":"Create a DRAFT or READY case with ordered steps.","auth":"bearer","permission":"DEFINITION_MANAGE","pathParams":{"projectId":"UUID","suiteId":"UUID"},"query":[],"headers":[],"body":{"name":"Homepage smoke","description":"Open the storefront","status":"DRAFT | READY","priority":"LOW | MEDIUM | HIGH | CRITICAL","tags":"comma-separated tags","retryCount":"0–5","steps":[{"position":0,"action":"NAVIGATE","locatorType":null,"locatorValue":null,"locatorRole":null,"locatorIndex":null,"inputValue":"/","expectedValue":null,"timeoutMs":30000,"viewportWidth":null,"viewportHeight":null,"locale":null,"timezoneId":null}],"projectVersion":"current numeric version"},"validation":["name is required and at most 200 characters","description is at most 4000 characters","DRAFT may have zero/partial steps","READY requires at least one step beginning with NAVIGATE and complete action fields","step timeout is 100–120000 ms","viewport and locale/timezone settings are constrained and apply to the first step"],"success":{"status":201,"shape":"CaseResponse"},"errors":[400,401,403,404,409,500],"example":"POST /api/v1/projects/<project-id>/suites/<suite-id>/cases"},
      {"method":"GET","path":"/projects/{projectId}/suites/{suiteId}/cases/{caseId}","summary":"Read a case and its ordered steps.","auth":"bearer","permission":"project member","pathParams":{"projectId":"UUID","suiteId":"UUID","caseId":"UUID"},"query":[],"headers":[],"body":null,"success":{"status":200,"shape":"CaseResponse"},"errors":[401,403,404,500],"example":"GET /api/v1/projects/<project-id>/suites/<suite-id>/cases/<case-id>"},
      {"method":"PUT","path":"/projects/{projectId}/suites/{suiteId}/cases/{caseId}","summary":"Replace case metadata and the ordered step aggregate.","auth":"bearer","permission":"DEFINITION_MANAGE","pathParams":{"projectId":"UUID","suiteId":"UUID","caseId":"UUID"},"query":[],"headers":[],"body":"Same CaseRequest shape as create, including projectVersion and complete ordered steps.","success":{"status":200,"shape":"CaseResponse"},"errors":[400,401,403,404,409,500],"example":"PUT /api/v1/projects/<project-id>/suites/<suite-id>/cases/<case-id>"},
      {"method":"DELETE","path":"/projects/{projectId}/suites/{suiteId}/cases/{caseId}","summary":"Move one case to history-preserving Trash.","auth":"bearer","permission":"DEFINITION_MANAGE","pathParams":{"projectId":"UUID","suiteId":"UUID","caseId":"UUID"},"query":[],"headers":{"If-Match":"current numeric version"},"body":null,"success":{"status":200,"shape":"CaseResponse with archived metadata"},"errors":[401,403,404,409,500],"example":"DELETE /api/v1/projects/<project-id>/suites/<suite-id>/cases/<case-id>"},
      {"method":"POST","path":"/projects/{projectId}/suites/{suiteId}/cases/{caseId}/restore","summary":"Restore an archived case as DRAFT, optionally renaming it.","auth":"bearer","permission":"DEFINITION_MANAGE","pathParams":{"projectId":"UUID","suiteId":"UUID","caseId":"UUID"},"query":[],"headers":[],"body":{"version":"current numeric version","name":"optional replacement name"},"success":{"status":200,"shape":"CaseResponse with status DRAFT"},"errors":[400,401,403,404,409,500],"example":"POST /api/v1/projects/<project-id>/suites/<suite-id>/cases/<case-id>/restore"}
    ]},
    {"id":"executions","label":"Executions and evidence","source":["backend/src/main/java/com/megumi/testops/execution/api/ExecutionController.java"],"endpoints":[
