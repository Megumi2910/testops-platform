    {
      "id": "auth",
      "label": "Authentication and account security",
      "source": ["backend/src/main/java/com/megumi/testops/auth/api/AuthController.java"],
      "endpoints": [
        {"method":"GET","path":"/auth/providers","summary":"Read enabled providers and platform capabilities.","auth":"public","permission":null,"query":[],"headers":[],"body":null,"success":{"status":200,"shape":"ProvidersResponse"},"errors":[400,500],"example":"GET /api/v1/auth/providers"},
        {"method":"POST","path":"/auth/register","summary":"Create a password account and begin email verification.","auth":"public","permission":null,"query":[],"headers":[],"body":{"email":"qa.user@example.test","displayName":"QA User","password":"<12+ character password>"},"validation":["email is required, valid, and at most 254 characters","displayName is 2–100 characters","password is 12–128 characters"],"success":{"status":200,"shape":"MessageResponse; verification required"},"errors":[400,409,429,500],"example":"POST /api/v1/auth/register"},
        {"method":"POST","path":"/auth/email/verify","summary":"Consume a six-digit registration OTP and issue a session.","auth":"public","permission":null,"query":[],"headers":[],"body":{"email":"qa.user@example.test","otp":"<six digits>"},"validation":["email is valid","otp matches \\d{6}"],"success":{"status":200,"shape":"AuthResponse"},"errors":[400,409,429,500],"example":"POST /api/v1/auth/email/verify"},
        {"method":"POST","path":"/auth/email/resend","summary":"Resend a registration OTP with server cooldown and idempotency safeguards.","auth":"public","permission":null,"query":[],"headers":[],"body":{"email":"qa.user@example.test"},"validation":["email is valid"],"success":{"status":200,"shape":"ResendVerificationResponse"},"errors":[400,404,409,429,500],"example":"POST /api/v1/auth/email/resend"},
        {"method":"POST","path":"/auth/password/reset/request","summary":"Request a generic password-reset challenge without revealing account existence.","auth":"public","permission":null,"query":[],"headers":[],"body":{"email":"qa.user@example.test"},"validation":["email is valid"],"success":{"status":200,"shape":"ResendVerificationResponse; generic response"},"errors":[400,429,500],"example":"POST /api/v1/auth/password/reset/request"},
        {"method":"POST","path":"/auth/password/reset/confirm","summary":"Verify a reset OTP and set a new password.","auth":"public","permission":null,"query":[],"headers":[],"body":{"email":"qa.user@example.test","otp":"<six digits>","password":"<12+ character password>"},"validation":["email is valid","otp is six digits","password is 12–128 characters"],"success":{"status":204,"shape":"empty; refresh sessions are revoked"},"errors":[400,409,429,500],"example":"POST /api/v1/auth/password/reset/confirm"},
        {"method":"POST","path":"/auth/me/email/resend","summary":"Resend verification for the signed-in unverified user.","auth":"bearer","permission":"authenticated user","query":[],"headers":[],"body":null,"success":{"status":200,"shape":"ResendVerificationResponse"},"errors":[401,403,409,429,500],"example":"POST /api/v1/auth/me/email/resend"},
        {"method":"POST","path":"/auth/login","summary":"Authenticate a password account and return an access token plus user summary.","auth":"public","permission":null,"query":[],"headers":[],"body":{"email":"qa.user@example.test","password":"<password>"},"validation":["email is valid","password is required"],"success":{"status":200,"shape":"AuthResponse; refresh cookie may be set"},"errors":[400,401,403,409,429,500],"example":"POST /api/v1/auth/login"},
        {"method":"POST","path":"/auth/refresh","summary":"Rotate the refresh cookie and issue a new access token.","auth":"refresh cookie","permission":null,"query":[],"headers":[],"body":null,"success":{"status":200,"shape":"AuthResponse"},"errors":[401,409,429,500],"example":"POST /api/v1/auth/refresh"},
        {"method":"POST","path":"/auth/logout","summary":"Revoke the current refresh session and clear the cookie.","auth":"refresh cookie","permission":null,"query":[],"headers":[],"body":null,"success":{"status":204,"shape":"empty"},"errors":[401,500],"example":"POST /api/v1/auth/logout"},
        {"method":"GET","path":"/auth/me","summary":"Read the current user and effective identity state.","auth":"bearer","permission":"authenticated user","query":[],"headers":[],"body":null,"success":{"status":200,"shape":"UserSummaryResponse"},"errors":[401,403,500],"example":"GET /api/v1/auth/me"},
        {"method":"POST","path":"/auth/sessions/revoke-all","summary":"Revoke every refresh session for the current user, including the current browser.","auth":"bearer","permission":"authenticated user","query":[],"headers":[],"body":null,"success":{"status":204,"shape":"empty"},"errors":[401,500],"example":"POST /api/v1/auth/sessions/revoke-all"},
        {"method":"POST","path":"/auth/me/password/challenge","summary":"Send a password-setup OTP for a Google-only account.","auth":"bearer","permission":"authenticated user","query":[],"headers":[],"body":null,"success":{"status":200,"shape":"MessageResponse"},"errors":[401,409,429,500],"example":"POST /api/v1/auth/me/password/challenge"},
        {"method":"POST","path":"/auth/me/password/confirm","summary":"Confirm a password-setup OTP and create a local password.","auth":"bearer","permission":"authenticated user","query":[],"headers":[],"body":{"otp":"<six digits>","password":"<12+ character password>"},"validation":["otp is required","password is 12–128 characters"],"success":{"status":204,"shape":"empty; current user summary must be refreshed"},"errors":[400,401,409,429,500],"example":"POST /api/v1/auth/me/password/confirm"},
        {"method":"PUT","path":"/auth/me/password","summary":"Change the current password and revoke all refresh sessions.","auth":"bearer","permission":"authenticated user","query":[],"headers":[],"body":{"currentPassword":"<current password>","newPassword":"<12+ character password>"},"validation":["both passwords are required","newPassword is 12–128 characters"],"success":{"status":204,"shape":"empty; client must return to sign in"},"errors":[400,401,409,500],"example":"PUT /api/v1/auth/me/password"},
        {"method":"POST","path":"/auth/me/login-methods/google/unlink","summary":"Unlink Google after current-password confirmation.","auth":"bearer","permission":"authenticated user","query":[],"headers":[],"body":{"currentPassword":"<current password>"},"success":{"status":204,"shape":"empty; sessions are revoked"},"errors":[400,401,409,500],"example":"POST /api/v1/auth/me/login-methods/google/unlink"},
        {"method":"POST","path":"/auth/me/login-methods/google/link-intent","summary":"Return the configured Google authorization URL for linking.","auth":"bearer","permission":"authenticated user","query":[],"headers":[],"body":null,"success":{"status":200,"shape":"object containing authorizationUrl"},"errors":[401,409,500],"example":"POST /api/v1/auth/me/login-methods/google/link-intent"}
      ]
    },
