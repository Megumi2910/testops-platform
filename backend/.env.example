DB_URL=jdbc:postgresql://postgres:5432/testops
DB_USERNAME=testops
DB_PASSWORD=replace-me-local
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:3000
AUTH_ENABLED=false
AUTH_REGISTRATION_ENABLED=false
JWT_PRIVATE_KEY_PATH=/run/secrets/testops/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/testops/jwt-public.pem
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=testops-api
JWT_KEY_ID=local-m2
JWT_ACCESS_TTL=PT10M
JWT_CLOCK_SKEW=PT30S
REFRESH_COOKIE_NAME=testops_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_TOKEN_TTL=P14D
EMAIL_DELIVERY_ENABLED=false
EMAIL_OTP_PEPPER_PATH=/run/secrets/testops/email-otp-pepper
EMAIL_OTP_LIFETIME=PT10M
EMAIL_OTP_RESEND_DELAY=PT1M
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_MAX_SENDS_PER_HOUR=5
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=TestOps Platform
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_STARTTLS_REQUIRED=false
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_PASSWORD_PATH=/run/secrets/testops/bootstrap-admin-password
PROJECT_VARIABLE_KEY_PATH=/run/secrets/testops/project-variable-key
PROJECT_VARIABLE_KEY_VERSION=1
PROJECT_SECRET_VARIABLES_ENABLED=false
OPENAPI_ENABLED=false
TARGET_ALLOWED_ORIGINS=https://shop.example.test
