            { "position": 2, "action": "ASSERT_VISIBLE", "locatorType": "ROLE", "locatorRole": "HEADING", "locatorValue": "Gửi tin nhắn cho chúng tôi", "timeoutMs": 15000 },
            { "position": 3, "action": "TAKE_SCREENSHOT", "timeoutMs": 15000 }
          ]
