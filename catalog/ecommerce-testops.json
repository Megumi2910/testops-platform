            { "position": 2, "action": "ASSERT_VISIBLE", "locatorType": "ROLE", "locatorRole": "HEADING", "locatorValue": "Chủ đề phổ biến", "timeoutMs": 15000 },
            { "position": 3, "action": "TAKE_SCREENSHOT", "timeoutMs": 15000 }
          ]
        }
      ]
    },
    {
      "key": "20-auth-verification",
      "name": "20 — Authentication and Verification",
      "description": "Login, verification, reset, logout, and protected routes. [testops-key:20-auth-verification]",
      "cases": [
        {
          "key": "login-valid",
          "name": "Valid login",
          "status": "READY",
          "priority": "P0",
          "tags": "sync:ecommerce-login-valid,role:customer,state:seeded,runner:testops",
          "description": "Credentialed login uses the permanent verified mock customer fixture and does not mutate ecommerce state.",
          "steps": [
            { "position": 0, "action": "NAVIGATE", "inputValue": "/login", "timeoutMs": 15000 },
            { "position": 1, "action": "FILL", "locatorType": "ROLE", "locatorRole": "TEXTBOX", "locatorValue": "Email", "inputValue": "${E2E_CUSTOMER_EMAIL}", "timeoutMs": 15000 },
            { "position": 2, "action": "FILL", "locatorType": "ROLE", "locatorRole": "TEXTBOX", "locatorValue": "Mật khẩu", "inputValue": "${E2E_CUSTOMER_PASSWORD}", "timeoutMs": 15000 },
            { "position": 3, "action": "CLICK", "locatorType": "ROLE", "locatorRole": "BUTTON", "locatorValue": "Đăng nhập", "timeoutMs": 15000 },
            { "position": 4, "action": "ASSERT_URL_EQUALS", "expectedValue": "/", "timeoutMs": 15000 },
            { "position": 5, "action": "ASSERT_VISIBLE", "locatorType": "ROLE", "locatorRole": "HEADING", "locatorValue": "Danh mục sản phẩm", "timeoutMs": 15000 }
          ]
        },
        {
          "key": "login-invalid",
          "name": "Reject invalid login",
          "status": "READY",
          "priority": "P1",
          "tags": "sync:ecommerce-login-invalid,role:guest,state:clean,runner:testops",
          "description": "Reject an unknown account with a structured authentication message while keeping the user on the login page.",
          "steps": [
            { "position": 0, "action": "NAVIGATE", "inputValue": "/login", "timeoutMs": 15000 },
            { "position": 1, "action": "FILL", "locatorType": "ROLE", "locatorRole": "TEXTBOX", "locatorValue": "Email", "inputValue": "missing-user@example.test", "timeoutMs": 15000 },
            { "position": 2, "action": "FILL", "locatorType": "ROLE", "locatorRole": "TEXTBOX", "locatorValue": "Mật khẩu", "inputValue": "WrongPassword!123", "timeoutMs": 15000 },
            { "position": 3, "action": "CLICK", "locatorType": "ROLE", "locatorRole": "BUTTON", "locatorValue": "Đăng nhập", "timeoutMs": 15000 },
            { "position": 4, "action": "ASSERT_VISIBLE", "locatorType": "TEXT_EXACT", "locatorValue": "Invalid email or password", "locatorIndex": 0, "timeoutMs": 15000 },
            { "position": 5, "action": "TAKE_SCREENSHOT", "timeoutMs": 15000 }
          ]
        },
        {
          "key": "login-logout",
          "name": "Logout protects the session",
          "status": "READY",
          "priority": "P1",
