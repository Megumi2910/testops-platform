{
  "schemaVersion": 1,
  "project": {
    "key": "ecommerce-platform",
    "name": "Ecommerce",
    "description": "Reusable browser checks for the local ecommerce storefront. [testops-key:ecommerce-platform]",
    "targetOrigin": "http://localhost:3001"
  },
  "variables": [
    { "key": "E2E_CUSTOMER_EMAIL", "secret": false, "valueFromEnv": "TESTOPS_E2E_CUSTOMER_EMAIL" },
    { "key": "E2E_CUSTOMER_PASSWORD", "secret": true, "valueFromEnv": "TESTOPS_E2E_CUSTOMER_PASSWORD" }
  ],
  "suites": [
    {
      "key": "00-platform-smoke",
      "name": "00 — Platform Smoke",
      "description": "Guest storefront availability and fatal-error smoke. [testops-key:00-platform-smoke]",
      "cases": [
        {
          "key": "homepage-smoke",
          "name": "Homepage smoke",
          "status": "READY",
          "priority": "P0",
          "tags": "sync:ecommerce-homepage-smoke,role:guest,state:clean,runner:testops",
          "description": "Open the storefront homepage and verify its product category landmark.",
          "steps": [
            { "position": 0, "action": "NAVIGATE", "inputValue": "/", "timeoutMs": 15000, "viewportWidth": 1280, "viewportHeight": 720, "locale": "en-US", "timezoneId": "Asia/Ho_Chi_Minh" },
            { "position": 1, "action": "ASSERT_VISIBLE", "locatorType": "TEXT_EXACT", "locatorValue": "Danh mục sản phẩm", "timeoutMs": 15000, "locatorIndex": 0 },
            { "position": 2, "action": "TAKE_SCREENSHOT", "timeoutMs": 15000 }
          ]
        }
      ]
    },
    {
      "key": "10-catalog-search",
      "name": "10 — Catalog and Search",
      "description": "Catalog, details, search, filters, sorting, and URL state. [testops-key:10-catalog-search]",
      "cases": [
        {
          "key": "catalog-homepage",
          "name": "Catalog homepage",
          "status": "READY",
          "priority": "P1",
          "tags": "sync:ecommerce-catalog-homepage,role:guest,state:clean,runner:testops",
          "description": "Verify the storefront catalog entry point is visible.",
          "steps": [
            { "position": 0, "action": "NAVIGATE", "inputValue": "/", "timeoutMs": 15000 },
            { "position": 1, "action": "ASSERT_VISIBLE", "locatorType": "TEXT", "locatorValue": "Danh mục sản phẩm", "timeoutMs": 15000 }
          ]
        },
        {
          "key": "search-state",
          "name": "Search state is shareable",
          "status": "READY",
          "priority": "P1",
          "tags": "sync:ecommerce-search-state,role:guest,state:clean,runner:testops",
          "description": "Verify a search query is reflected in the input and URL without requiring an account.",
          "steps": [
            { "position": 0, "action": "NAVIGATE", "inputValue": "/search?q=shirt", "timeoutMs": 15000 },
            { "position": 1, "action": "ASSERT_VALUE", "locatorType": "LABEL", "locatorValue": "Tìm kiếm sản phẩm", "expectedValue": "shirt", "timeoutMs": 15000 },
            { "position": 2, "action": "ASSERT_URL_EQUALS", "expectedValue": "/search?q=shirt", "timeoutMs": 15000 },
            { "position": 3, "action": "TAKE_SCREENSHOT", "timeoutMs": 15000 }
          ]
        },
        {
          "key": "search-empty-state",
          "name": "Search no-results state",
          "status": "READY",
          "priority": "P1",
          "tags": "sync:ecommerce-search-empty-state,role:guest,state:clean,runner:testops",
          "description": "Verify an unknown search term produces the intentional empty state instead of a blank page.",
          "steps": [
            { "position": 0, "action": "NAVIGATE", "inputValue": "/search?q=definitely-no-local-product-9f4c", "timeoutMs": 15000 },
            { "position": 1, "action": "ASSERT_VISIBLE", "locatorType": "ROLE", "locatorRole": "HEADING", "locatorValue": "Không tìm thấy sản phẩm", "timeoutMs": 15000 },
            { "position": 2, "action": "TAKE_SCREENSHOT", "timeoutMs": 15000 }
          ]
        },
        {
          "key": "product-detail",
          "name": "Product detail page",
          "status": "READY",
          "priority": "P1",
          "tags": "sync:ecommerce-product-detail,role:guest,state:clean,runner:testops",
          "description": "Open the permanent mock t-shirt fixture and verify its purchase and seller information.",
          "steps": [
            { "position": 0, "action": "NAVIGATE", "inputValue": "/product/1", "timeoutMs": 15000 },
            { "position": 1, "action": "ASSERT_VISIBLE", "locatorType": "TEXT_EXACT", "locatorValue": "Áo thun basic cotton", "timeoutMs": 15000, "locatorIndex": 0 },
            { "position": 2, "action": "ASSERT_VISIBLE", "locatorType": "TEXT_EXACT", "locatorValue": "Mock Local Store", "timeoutMs": 15000, "locatorIndex": 0 },
            { "position": 3, "action": "ASSERT_VISIBLE", "locatorType": "ROLE", "locatorRole": "BUTTON", "locatorValue": "Mua ngay", "timeoutMs": 15000 },
            { "position": 4, "action": "TAKE_SCREENSHOT", "timeoutMs": 15000 }
          ]
        },
        {
          "key": "category-browse",
          "name": "Browse a category",
          "status": "READY",
          "priority": "P1",
          "tags": "sync:ecommerce-category-browse,role:guest,state:clean,runner:testops",
          "description": "Open the permanent fashion category fixture and verify its result count and product card.",
          "steps": [
            { "position": 0, "action": "NAVIGATE", "inputValue": "/category/1", "timeoutMs": 15000 },
            { "position": 1, "action": "ASSERT_VISIBLE", "locatorType": "TEXT_EXACT", "locatorValue": "Thời trang", "timeoutMs": 15000, "locatorIndex": 0 },
            { "position": 2, "action": "ASSERT_VISIBLE", "locatorType": "TEXT_EXACT", "locatorValue": "Tìm thấy 1 sản phẩm", "timeoutMs": 15000, "locatorIndex": 0 },
            { "position": 3, "action": "ASSERT_VISIBLE", "locatorType": "TEXT_EXACT", "locatorValue": "Áo thun basic cotton", "timeoutMs": 15000, "locatorIndex": 0 },
            { "position": 4, "action": "TAKE_SCREENSHOT", "timeoutMs": 15000 }
          ]
        },
        {
          "key": "categories-directory",
          "name": "Browse the category directory",
          "status": "READY",
          "priority": "P1",
          "tags": "sync:ecommerce-categories-directory,role:guest,state:clean,runner:testops",
          "description": "Open the public category directory and verify the permanent category fixtures.",
          "steps": [
            { "position": 0, "action": "NAVIGATE", "inputValue": "/categories", "timeoutMs": 15000 },
            { "position": 1, "action": "ASSERT_VISIBLE", "locatorType": "ROLE", "locatorRole": "HEADING", "locatorValue": "Danh mục sản phẩm", "timeoutMs": 15000 },
            { "position": 2, "action": "ASSERT_VISIBLE", "locatorType": "ROLE", "locatorRole": "HEADING", "locatorValue": "Thời trang", "timeoutMs": 15000 },
            { "position": 3, "action": "ASSERT_VISIBLE", "locatorType": "ROLE", "locatorRole": "HEADING", "locatorValue": "Điện tử", "timeoutMs": 15000 },
            { "position": 4, "action": "ASSERT_VISIBLE", "locatorType": "ROLE", "locatorRole": "HEADING", "locatorValue": "Gia dụng", "timeoutMs": 15000 },
            { "position": 5, "action": "TAKE_SCREENSHOT", "timeoutMs": 15000 }
          ]
        },
        {
          "key": "flash-sale-page",
          "name": "Open the flash sale page",
          "status": "READY",
          "priority": "P1",
          "tags": "sync:ecommerce-flash-sale-page,role:guest,state:clean,runner:testops",
          "description": "Verify the public flash-sale route renders its intentional page headings.",
          "steps": [
            { "position": 0, "action": "NAVIGATE", "inputValue": "/flash-sale", "timeoutMs": 15000 },
            { "position": 1, "action": "ASSERT_VISIBLE", "locatorType": "TEXT_EXACT", "locatorValue": "FLASH SALE", "timeoutMs": 15000, "locatorIndex": 0 },
            { "position": 2, "action": "ASSERT_VISIBLE", "locatorType": "TEXT_EXACT", "locatorValue": "Sản phẩm Flash Sale", "timeoutMs": 15000, "locatorIndex": 0 },
            { "position": 3, "action": "TAKE_SCREENSHOT", "timeoutMs": 15000 }
          ]
        },
        {
          "key": "about-page",
          "name": "Read the about page",
          "status": "READY",
          "priority": "P2",
          "tags": "sync:ecommerce-about-page,role:guest,state:clean,runner:testops",
          "description": "Verify the public about page renders its story content.",
          "steps": [
            { "position": 0, "action": "NAVIGATE", "inputValue": "/about", "timeoutMs": 15000 },
            { "position": 1, "action": "ASSERT_VISIBLE", "locatorType": "ROLE", "locatorRole": "HEADING", "locatorValue": "Về chúng tôi", "timeoutMs": 15000 },
            { "position": 2, "action": "ASSERT_VISIBLE", "locatorType": "ROLE", "locatorRole": "HEADING", "locatorValue": "Câu chuyện của chúng tôi", "timeoutMs": 15000 },
            { "position": 3, "action": "TAKE_SCREENSHOT", "timeoutMs": 15000 }
