          "description": "Sign in with the permanent customer fixture, sign out from the account menu, and confirm the protected session returns to login.",
          "steps": [
            { "position": 0, "action": "NAVIGATE", "inputValue": "/login", "timeoutMs": 15000 },
            { "position": 1, "action": "FILL", "locatorType": "ROLE", "locatorRole": "TEXTBOX", "locatorValue": "Email", "inputValue": "${E2E_CUSTOMER_EMAIL}", "timeoutMs": 15000 },
            { "position": 2, "action": "FILL", "locatorType": "ROLE", "locatorRole": "TEXTBOX", "locatorValue": "Mật khẩu", "inputValue": "${E2E_CUSTOMER_PASSWORD}", "timeoutMs": 15000 },
            { "position": 3, "action": "CLICK", "locatorType": "ROLE", "locatorRole": "BUTTON", "locatorValue": "Đăng nhập", "timeoutMs": 15000 },
            { "position": 4, "action": "ASSERT_URL_EQUALS", "expectedValue": "/", "timeoutMs": 15000 },
            { "position": 5, "action": "CLICK", "locatorType": "ROLE", "locatorRole": "BUTTON", "locatorValue": "Mock Customer", "timeoutMs": 15000 },
            { "position": 6, "action": "CLICK", "locatorType": "ROLE", "locatorRole": "BUTTON", "locatorValue": "Đăng xuất", "timeoutMs": 15000 },
            { "position": 7, "action": "ASSERT_URL_EQUALS", "expectedValue": "/", "timeoutMs": 15000 },
            { "position": 8, "action": "ASSERT_VISIBLE", "locatorType": "ROLE", "locatorRole": "LINK", "locatorValue": "Đăng nhập", "timeoutMs": 15000 },
            { "position": 9, "action": "NAVIGATE", "inputValue": "/customer/orders", "timeoutMs": 15000 },
            { "position": 10, "action": "ASSERT_URL_EQUALS", "expectedValue": "/login", "timeoutMs": 15000 },
            { "position": 11, "action": "ASSERT_VISIBLE", "locatorType": "ROLE", "locatorRole": "HEADING", "locatorValue": "Chào mừng trở lại!", "timeoutMs": 15000 },
            { "position": 12, "action": "TAKE_SCREENSHOT", "timeoutMs": 15000 }
          ]
        },
